{
  "name": "clw-api-worker",
  "version": "0.1.0",
  "private": true,
  "description": "CloudLab Works public HTTP API on Cloudflare Workers: NC2 IAM permission lists and receipt checks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "../scripts/build-wasm.sh",
    "build:openapi": "node scripts/openapi-json.mjs",
    "check:openapi": "node scripts/openapi-json.mjs --check",
    "lint:openapi": "redocly lint ../openapi/openapi.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "dev": "wrangler dev --local"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@redocly/cli": "^2.73.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "yaml": "^2.9.1"
  }
}
